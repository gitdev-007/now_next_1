# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration (Supabase Connection)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-on-client

# JWT secrets
JWT_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production

# CORS configuration
FRONTEND_URL=http://localhost:8000
